# ASR Settings
ASR_MODEL=medium
DEVICE=cpu
COMPUTE_TYPE=int8
BATCH_SIZE=4

# Diarization
ENABLE_DIARIZATION=true
DIARIZATION_MODEL=pyannote/speaker-diarization-community-1
HF_TOKEN=your_huggingface_token_here

# LLM MoM Settings
LLM_PROVIDER=groq
GROQ_MODEL=llama3-8b-8192
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=2048
GROQ_API_KEY=your_groq_api_key_here
